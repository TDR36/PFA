#define INTEGRATION_C

#include "integration.h"

bool setQuadFormula(QuadFormula* qf, char* name)
{
	if (!strcmp("right", name))
	{
		qf->n=0;
		qf->w=1;
		qf->x=1;
	}
	else if (!strcmp("left", name)){
		qf->n=0;
		qf->w=1;
		qf->x=0;
	}
	else if (!strcmp("middle", name)){
		qf->n=0;
		qf->w=1;
		qf->x=0.5;
	}
	
	else if (!strcmp("trapezes", name))
	{
		qf->n=1;
		qf->w=0.5;
		qf->x=0;
	};

	else if (strcmp("gauss2", name)&&strcmp("gauss3", name)&&
	else if (!strcmp("simpson", name)){


	strcpy(qf->name, name);
	return true;
}

void printQuadFormula(QuadFormula* qf)
{
  printf("Quadratic formula: %s\n", qf->name);
}

double integrate(double (*f)(double), double a, double b, int N, QuadFormula* qf)
{
	if (strcpy(qf->name)=="simpson":
		simpson
			
	double result=0.0, a_aux,b_aux;
	double result_aux=0.0;
	for (int i=0; i<N; i++){

		a_aux = a +i *((b-a)/N);
		b_aux = a+(i+1)*((b-a)/N);
		result_aux=0.0;
		for (int j=0; j<=qf->n;j++){
			result_aux+=qf->w*(*f)(a_aux +qf->x*(b_aux-a_aux));
			
			qf->x=1;
		}
		result += (b_aux-a_aux)*result_aux;
	}
	printf("%.2f\n",result);
	return result;
}





double integrate_dx(double (*f)(double), double a, double b, double dx, QuadFormula* qf)
{
	size_t N = (int)round(abs(b-a)/dx);
	if (!N) N=1;
	return integrate(f, a, b, N, qf);
}


